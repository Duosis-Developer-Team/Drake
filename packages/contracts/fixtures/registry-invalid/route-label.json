{
  "apiVersion": "drake.duosis.com/v1alpha1",
  "kind": "MetricCatalog",
  "metrics": [
    {
      "key": "service.request_rate",
      "version": 1,
      "type": "counter_rate",
      "unit": "requests_per_second",
      "sourceType": "prometheus",
      "sourceFamily": "http_server_requests_total",
      "allowedInputLabels": ["project", "route"],
      "allowedOutputLabels": ["path"],
      "capability": "telemetry",
      "profiles": ["fastapi-v1"],
      "lifecycle": "active",
      "description": "raw route labels must be rejected",
      "provenance": {"kind": "registry", "ref": "test", "revision": "1"}
    }
  ]
}
