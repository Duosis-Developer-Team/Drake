{
  "apiVersion": "drake.duosis.com/v1alpha1",
  "kind": "QueryTemplateRegistry",
  "templates": [
    {
      "key": "ghost.query.v1",
      "version": 1,
      "metricKey": "metric.that.does.not.exist",
      "metricVersion": 9,
      "providerType": "prometheus",
      "expression": "sum(rate(ghost_total{ {{matchers}} }[{{window}}]))",
      "scopeTypes": ["service"],
      "permission": "telemetry.query",
      "matchers": [{"label": "project", "source": "project_key"}],
      "parameters": {},
      "budgets": {
        "maxRangeSeconds": 3600,
        "minStepSeconds": 30,
        "maxSeries": 10,
        "maxPoints": 1000,
        "timeoutSeconds": 5
      },
      "cache": {"freshTtlSeconds": 30, "staleTtlSeconds": 900},
      "output": {"resultType": "timeseries", "unit": "count", "labels": []},
      "semantics": {"empty": "no_data", "partial": "null_points_with_warning"}
    }
  ]
}
