{
  "apiVersion": "drake.duosis.com/v1alpha1",
  "kind": "DashboardTemplateRegistry",
  "dashboards": [
    {
      "key": "cluster-capacity-v1",
      "version": 1,
      "profiles": [
        "kubernetes-service-v1"
      ],
      "scopeTypes": [
        "cluster"
      ],
      "title": "Cluster capacity",
      "summary": "What the cluster can schedule and what it is using: CPU, memory and the fullest filesystem on any node. Host pressure, not workload demand.",
      "sections": [
        {
          "key": "compute",
          "title": "Compute",
          "widgets": [
            {
              "key": "cpu-used",
              "title": "CPU in use",
              "display": "timeseries",
              "queryTemplateKey": "cluster.cpu-used.v1",
              "reducer": "latest",
              "unit": "cores",
              "emptyBehavior": "show_empty",
              "accessibleSummary": "CPU the cluster is consuming, excluding idle."
            },
            {
              "key": "cpu-allocatable",
              "title": "CPU schedulable",
              "display": "kpi",
              "queryTemplateKey": "cluster.cpu-allocatable.v1",
              "reducer": "latest",
              "unit": "cores",
              "emptyBehavior": "show_empty",
              "accessibleSummary": "CPU the Ready nodes can schedule."
            },
            {
              "key": "memory-used",
              "title": "Memory in use",
              "display": "timeseries",
              "queryTemplateKey": "cluster.memory-used.v1",
              "reducer": "latest",
              "unit": "bytes",
              "emptyBehavior": "show_empty",
              "accessibleSummary": "Total memory minus what the kernel reports available."
            },
            {
              "key": "memory-allocatable",
              "title": "Memory schedulable",
              "display": "kpi",
              "queryTemplateKey": "cluster.memory-allocatable.v1",
              "reducer": "latest",
              "unit": "bytes",
              "emptyBehavior": "show_empty",
              "accessibleSummary": "Memory the Ready nodes can schedule."
            }
          ]
        },
        {
          "key": "storage",
          "title": "Storage",
          "widgets": [
            {
              "key": "filesystem",
              "title": "Fullest filesystem",
              "display": "timeseries",
              "queryTemplateKey": "cluster.filesystem-used-ratio.v1",
              "reducer": "latest",
              "unit": "ratio",
              "emptyBehavior": "show_empty",
              "accessibleSummary": "The fullest real filesystem on any node; an average would hide the one about to fill."
            }
          ]
        }
      ]
    },
    {
      "key": "project-environment-overview-v1",
      "version": 1,
      "title": "Environment overview",
      "profiles": [
        "fastapi-v1",
        "nextjs-v1",
        "kubernetes-service-v1"
      ],
      "scopeTypes": [
        "environment"
      ],
      "summary": "Golden-signal overview for one authorized environment: request throughput, error share, p95 latency, and telemetry source state.",
      "sections": [
        {
          "key": "failures",
          "title": "Not running",
          "widgets": [
            {
              "key": "env-waiting-reason",
              "title": "Containers waiting",
              "display": "timeseries",
              "queryTemplateKey": "environment.waiting-reason.v1",
              "reducer": "latest",
              "unit": "count",
              "emptyBehavior": "show_empty",
              "accessibleSummary": "Containers not running, one series per reason such as CrashLoopBackOff or ImagePullBackOff."
            },
            {
              "key": "env-replicas-unavailable",
              "title": "Replicas missing",
              "display": "kpi",
              "queryTemplateKey": "environment.replicas-unavailable.v1",
              "reducer": "latest",
              "unit": "replicas",
              "thresholds": {
                "warn": 1,
                "critical": 3,
                "direction": "above"
              },
              "emptyBehavior": "show_empty",
              "accessibleSummary": "Replicas the workloads want and do not have."
            },
            {
              "key": "env-pods-not-ready",
              "title": "Pods not ready",
              "display": "kpi",
              "queryTemplateKey": "environment.pods-not-ready.v1",
              "reducer": "latest",
              "unit": "count",
              "thresholds": {
                "warn": 1,
                "critical": 3,
                "direction": "above"
              },
              "emptyBehavior": "show_empty",
              "accessibleSummary": "Pods that exist but do not pass their readiness condition."
            }
          ]
        },
        {
          "key": "signals",
          "title": "Golden signals",
          "widgets": [
            {
              "key": "request-rate-kpi",
              "title": "Request rate",
              "display": "kpi",
              "queryTemplateKey": "environment.request-rate.v1",
              "reducer": "latest",
              "unit": "requests_per_second",
              "emptyBehavior": "show_empty",
              "accessibleSummary": "Current total request throughput across the environment's services."
            },
            {
              "key": "error-ratio-kpi",
              "title": "Error ratio",
              "display": "kpi",
              "queryTemplateKey": "environment.error-ratio.v1",
              "reducer": "latest",
              "unit": "ratio",
              "thresholds": {
                "warn": 0.01,
                "critical": 0.05,
                "direction": "above"
              },
              "emptyBehavior": "show_empty",
              "accessibleSummary": "Share of requests currently failing with server errors."
            },
            {
              "key": "latency-p95-kpi",
              "title": "p95 latency",
              "display": "kpi",
              "queryTemplateKey": "environment.latency-p95.v1",
              "reducer": "latest",
              "unit": "seconds",
              "thresholds": {
                "warn": 0.5,
                "critical": 2,
                "direction": "above"
              },
              "emptyBehavior": "show_empty",
              "accessibleSummary": "95th percentile request latency across the environment."
            },
            {
              "key": "scrape-state",
              "title": "Telemetry source",
              "display": "status",
              "queryTemplateKey": "environment.scrape-up.v1",
              "reducer": "latest",
              "unit": "count",
              "emptyBehavior": "show_empty",
              "accessibleSummary": "Whether the environment's telemetry targets are currently being scraped."
            }
          ]
        },
        {
          "key": "trends",
          "title": "Trends",
          "widgets": [
            {
              "key": "request-rate-by-service",
              "title": "Request rate by service",
              "display": "timeseries",
              "queryTemplateKey": "environment.request-rate.v1",
              "reducer": "latest",
              "unit": "requests_per_second",
              "emptyBehavior": "show_empty",
              "accessibleSummary": "Request throughput over time, one series per service.",
              "drilldownRoute": "/projects/{projectId}/environments/{environmentId}/services/{serviceId}"
            }
          ]
        },
        {
          "key": "workloads",
          "title": "Workloads",
          "widgets": [
            {
              "key": "env-cpu-usage",
              "title": "CPU in use",
              "display": "timeseries",
              "queryTemplateKey": "environment.cpu-usage.v1",
              "reducer": "latest",
              "unit": "cores",
              "emptyBehavior": "show_empty",
              "accessibleSummary": "CPU consumed by every workload Drake observes in this environment."
            },
            {
              "key": "env-memory-usage",
              "title": "Memory in use",
              "display": "timeseries",
              "queryTemplateKey": "environment.memory-usage.v1",
              "reducer": "latest",
              "unit": "bytes",
              "emptyBehavior": "show_empty",
              "accessibleSummary": "Working-set memory across this environment's workloads."
            },
            {
              "key": "env-restarts",
              "title": "Container restarts",
              "display": "kpi",
              "queryTemplateKey": "environment.container-restarts.v1",
              "reducer": "latest",
              "unit": "count",
              "emptyBehavior": "show_empty",
              "accessibleSummary": "Container restarts observed in this environment over the window."
            }
          ]
        }
      ]
    },
    {
      "key": "service-golden-signals-v1",
      "version": 1,
      "title": "Service golden signals",
      "profiles": [
        "fastapi-v1",
        "nextjs-v1",
        "kubernetes-service-v1"
      ],
      "scopeTypes": [
        "service"
      ],
      "summary": "Golden signals for one service binding: request rate, error ratio, p95 latency, telemetry source state, and workload signals where the runtime profile provides them.",
      "sections": [
        {
          "key": "signals",
          "title": "Golden signals",
          "widgets": [
            {
              "key": "request-rate-trend",
              "title": "Request rate",
              "display": "timeseries",
              "queryTemplateKey": "service.request-rate.v1",
              "reducer": "latest",
              "unit": "requests_per_second",
              "emptyBehavior": "show_empty",
              "accessibleSummary": "Request throughput for this service over the selected range."
            },
            {
              "key": "error-ratio-trend",
              "title": "Error ratio",
              "display": "timeseries",
              "queryTemplateKey": "service.error-ratio.v1",
              "reducer": "latest",
              "unit": "ratio",
              "thresholds": {
                "warn": 0.01,
                "critical": 0.05,
                "direction": "above"
              },
              "emptyBehavior": "show_empty",
              "accessibleSummary": "Share of this service's requests failing with server errors over time."
            },
            {
              "key": "latency-p95-trend",
              "title": "p95 latency",
              "display": "timeseries",
              "queryTemplateKey": "service.latency-p95.v1",
              "reducer": "latest",
              "unit": "seconds",
              "thresholds": {
                "warn": 0.5,
                "critical": 2,
                "direction": "above"
              },
              "emptyBehavior": "show_empty",
              "accessibleSummary": "95th percentile latency for this service over the selected range."
            },
            {
              "key": "scrape-state",
              "title": "Telemetry source",
              "display": "status",
              "queryTemplateKey": "service.scrape-up.v1",
              "reducer": "latest",
              "unit": "count",
              "emptyBehavior": "show_empty",
              "accessibleSummary": "Whether this service's telemetry target is currently being scraped."
            }
          ]
        },
        {
          "key": "workload",
          "title": "Workload",
          "widgets": [
            {
              "key": "container-restarts",
              "title": "Container restarts",
              "display": "kpi",
              "queryTemplateKey": "workload.container-restarts.v1",
              "reducer": "latest",
              "unit": "restarts",
              "thresholds": {
                "warn": 1,
                "critical": 5,
                "direction": "above"
              },
              "requiredProfile": "kubernetes-service-v1",
              "emptyBehavior": "show_empty",
              "accessibleSummary": "Container restarts in the selected window."
            },
            {
              "key": "cpu-utilization",
              "title": "CPU in use",
              "display": "kpi",
              "queryTemplateKey": "workload.cpu-utilization.v1",
              "reducer": "latest",
              "unit": "cores",
              "requiredProfile": "kubernetes-service-v1",
              "emptyBehavior": "show_empty",
              "accessibleSummary": "CPU cores currently used by this service's workload."
            }
          ]
        }
      ]
    }
  ]
}
