{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://drake.duosis.com/schemas/dashboard-template-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "dashboards"],
  "properties": {
    "apiVersion": {"const": "drake.duosis.com/v1alpha1"},
    "kind": {"const": "DashboardTemplateRegistry"},
    "dashboards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "version",
          "title",
          "profiles",
          "scopeTypes",
          "sections",
          "summary"
        ],
        "properties": {
          "key": {"$ref": "#/$defs/stableKey"},
          "version": {"type": "integer", "minimum": 1, "maximum": 10000},
          "title": {"type": "string", "minLength": 1, "maxLength": 120},
          "profiles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {"$ref": "#/$defs/stableKey"}
          },
          "scopeTypes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {"enum": ["environment", "service", "cluster"]}
          },
          "summary": {"type": "string", "minLength": 1, "maxLength": 500},
          "sections": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "title", "widgets"],
              "properties": {
                "key": {"$ref": "#/$defs/stableKey"},
                "title": {"type": "string", "minLength": 1, "maxLength": 120},
                "widgets": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 12,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "key",
                      "title",
                      "display",
                      "queryTemplateKey",
                      "reducer",
                      "unit",
                      "emptyBehavior"
                    ],
                    "properties": {
                      "key": {"$ref": "#/$defs/stableKey"},
                      "title": {"type": "string", "minLength": 1, "maxLength": 120},
                      "display": {"enum": ["kpi", "timeseries", "status"]},
                      "queryTemplateKey": {"$ref": "#/$defs/stableKey"},
                      "reducer": {"enum": ["latest", "avg", "max", "sum"]},
                      "unit": {
                        "enum": [
                          "requests_per_second",
                          "ratio",
                          "seconds",
                          "bytes",
                          "count",
                          "cores",
                          "restarts"
                        ]
                      },
                      "thresholds": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "warn": {"type": "number"},
                          "critical": {"type": "number"},
                          "direction": {"enum": ["above", "below"]}
                        },
                        "required": ["warn", "critical", "direction"]
                      },
                      "requiredProfile": {"$ref": "#/$defs/stableKey"},
                      "emptyBehavior": {"enum": ["show_empty", "show_zero_as_zero"]},
                      "accessibleSummary": {"type": "string", "maxLength": 300},
                      "drilldownRoute": {
                        "type": "string",
                        "maxLength": 200,
                        "pattern": "^/[a-zA-Z0-9/{}_-]*$"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "stableKey": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9_.-]{0,62}[a-z0-9])?$"
    }
  }
}
