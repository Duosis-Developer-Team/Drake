{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://drake.duosis.com/schemas/metric-catalog-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metrics"
  ],
  "properties": {
    "apiVersion": {
      "const": "drake.duosis.com/v1alpha1"
    },
    "kind": {
      "const": "MetricCatalog"
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "version",
          "type",
          "unit",
          "sourceType",
          "sourceFamily",
          "allowedInputLabels",
          "allowedOutputLabels",
          "capability",
          "profiles",
          "lifecycle",
          "description",
          "provenance"
        ],
        "properties": {
          "key": {
            "$ref": "#/$defs/stableKey"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "type": {
            "enum": [
              "counter_rate",
              "ratio",
              "histogram_quantile",
              "gauge",
              "snapshot"
            ]
          },
          "unit": {
            "enum": [
              "requests_per_second",
              "ratio",
              "seconds",
              "bytes",
              "count",
              "cores",
              "restarts"
            ]
          },
          "sourceType": {
            "enum": [
              "prometheus",
              "snapshot"
            ]
          },
          "sourceFamily": {
            "$ref": "#/$defs/metricFamily"
          },
          "quantile": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1
          },
          "allowedInputLabels": {
            "$ref": "#/$defs/labelList"
          },
          "allowedOutputLabels": {
            "$ref": "#/$defs/labelList"
          },
          "forbiddenLabels": {
            "$ref": "#/$defs/labelList"
          },
          "capability": {
            "enum": [
              "telemetry",
              "inventory",
              "tenant"
            ]
          },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "$ref": "#/$defs/stableKey"
            }
          },
          "lifecycle": {
            "enum": [
              "active",
              "deprecated"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "requiredMetadata": {
            "$ref": "#/$defs/labelList"
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "ref",
              "revision"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "registry"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "stableKey": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9_.-]{0,62}[a-z0-9])?$"
    },
    "labelName": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]{0,62}$"
    },
    "labelList": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/labelName"
      }
    },
    "metricFamily": {
      "type": "string",
      "pattern": "^[a-zA-Z_:][a-zA-Z0-9_:]*$",
      "maxLength": 200
    }
  }
}
