# Drake local development environment template.
# Copy to .env and adjust for YOUR LOCAL machine only.
# Never put real credentials, shared-environment hosts, or production values here.

# --- Drake API ---
DRAKE_ENV=local
DRAKE_API_HOST=127.0.0.1
DRAKE_API_PORT=8000

# Local Compose stack connection (see deploy/local/docker-compose.yml).
# The password below must match your local-only Compose configuration.
DRAKE_DATABASE_URL=postgresql+psycopg://drake:CHANGE_ME_LOCAL_ONLY@127.0.0.1:55432/drake
DRAKE_REDIS_URL=redis://127.0.0.1:56379/0

# --- Worker ---
DRAKE_WORKER_QUEUE=drake:jobs
