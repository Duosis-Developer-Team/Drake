# Drake local development environment template.
# Copy to .env and adjust for YOUR LOCAL machine only.
# Never put real credentials, shared-environment hosts, or production values here.

# --- Drake API ---
DRAKE_ENV=local
DRAKE_API_HOST=127.0.0.1
DRAKE_API_PORT=8000

# Local Compose stack connection (see deploy/local/docker-compose.yml).
# The password below must match your local-only Compose configuration.
DRAKE_DATABASE_URL=postgresql+psycopg://drake:CHANGE_ME_LOCAL_ONLY@127.0.0.1:55432/drake
DRAKE_REDIS_URL=redis://127.0.0.1:56379/0

# --- Worker ---
DRAKE_WORKER_QUEUE=drake:jobs

# --- GitHub App integration (Sprint 5A) ---
# Everything below is inert until DRAKE_GITHUB_APP_ENABLED is true.
# The two *_FILE values are PATHS into your local secret store — never the
# material itself, and never a real credential in this file.
DRAKE_GITHUB_APP_ENABLED=false
DRAKE_GITHUB_APP_CLIENT_ID=REPLACE_WITH_LOCAL_APP_CLIENT_ID
DRAKE_GITHUB_APP_PRIVATE_KEY_FILE=/absolute/path/to/local-only/github-app.pem
DRAKE_GITHUB_WEBHOOK_SECRET_FILE=/absolute/path/to/local-only/github-webhook-secret
DRAKE_GITHUB_API_BASE_URL=https://api.github.com
